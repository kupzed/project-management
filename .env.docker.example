# =============================================
# Docker Environment Variables
# =============================================
#
# CARA PAKAI:
# 1. Copy file ini:  cp .env.docker.example .env.docker
# 2. Edit isinya:    nano .env.docker
# 3. Generate password yang kuat untuk MySQL dan secrets
#
# PENTING:
# - Jangan commit file .env.docker ke repository!
# - Generate APP_KEY dan JWT_SECRET di VPS setelah container jalan
# - Semua password harus diganti dengan nilai yang kuat
#

# =============================================
# MySQL Database
# =============================================
MYSQL_ROOT_PASSWORD=ganti_dengan_password_root_yang_kuat
MYSQL_DATABASE=indogreen
MYSQL_USER=indogreen
MYSQL_PASSWORD=ganti_dengan_password_user_yang_kuat

# =============================================
# Laravel Backend
# =============================================
APP_NAME=indogreen-project-management
APP_ENV=production
APP_DEBUG=false
APP_URL=http://150.109.11.132

# Generate di VPS dengan: docker compose exec php php artisan key:generate --show
APP_KEY=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Database — "mysql" adalah nama service di docker-compose.yml
# Docker otomatis resolve nama ini ke IP container MySQL
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=indogreen
DB_USERNAME=indogreen
DB_PASSWORD=ganti_dengan_password_user_yang_kuat

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Generate di VPS dengan: docker compose exec php php artisan jwt:secret --show
JWT_SECRET=
JWT_ALGO=HS256

# =============================================
# AI Integration (Gemini)
# =============================================
AI_DRIVER=gemini
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_API_KEY=ganti_dengan_api_key_gemini_anda
AI_MODEL=gemini-2.5-flash-lite

# =============================================
# Frontend Build Args (digunakan saat docker build)
# =============================================
# Nilai ini di-"bake" ke dalam frontend saat build
# Harus sesuai dengan URL publik yang bisa diakses browser
PUBLIC_API_BASE_URL=http://150.109.11.132/api
PUBLIC_STORAGE_BASE_URL=http://150.109.11.132/storage
