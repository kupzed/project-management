# =============================================
# MySQL Custom Configuration
# =============================================
#
# Penjelasan:
# File ini mengoptimasi MySQL untuk VPS dengan 4GB RAM.
# Tanpa konfigurasi ini, MySQL bisa menggunakan RAM berlebihan
# atau memiliki default yang tidak optimal.

[mysqld]
# === Memory ===
# Buffer pool adalah cache utama MySQL untuk data & index
# Rule of thumb: 50-70% dari RAM yang dialokasikan untuk MySQL
# Kita alokasikan ~400MB untuk MySQL, jadi buffer pool = 256MB
innodb_buffer_pool_size = 256M

# Cache untuk table definitions (cukup kecil untuk app ini)
table_open_cache = 200

# === Connections ===
# Maksimal koneksi simultan
# PHP-FPM default ~5 worker, jadi 50 lebih dari cukup
max_connections = 50

# === Query ===
# Buffer untuk sorting (per koneksi, bukan global)
sort_buffer_size = 2M

# Buffer untuk join tanpa index
join_buffer_size = 2M

# === Logging ===
# Log query yang lambat (> 2 detik) — berguna untuk debugging
slow_query_log = 1
long_query_time = 2

# === Character Set ===
# UTF-8 4-byte (mendukung emoji)
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# === InnoDB ===
# Flush log setiap detik (kompromi antara performa dan durability)
innodb_flush_log_at_trx_commit = 2

# File format
innodb_file_per_table = 1

[client]
default-character-set = utf8mb4
